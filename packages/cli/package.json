{
  "name": "@shadscan/cli",
  "version": "0.17.1",
  "description": "Audit React shadcn apps for missing UI fundamentals.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://www.shadscan.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheOrcDev/shadscan.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "email": "orc@orcdev.com"
  },
  "keywords": [
    "shadcn",
    "accessibility",
    "audit",
    "cli",
    "react",
    "ui"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "shadscan": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "tsup",
    "docs:rules": "node --import tsx scripts/generate-rule-catalog.ts",
    "docs:rules:check": "node --import tsx scripts/generate-rule-catalog.ts --check",
    "prepack": "pnpm build",
    "release:check": "node scripts/check-release.mjs",
    "presmoke": "pnpm build",
    "smoke": "pnpm smoke:built",
    "smoke:built": "node scripts/smoke-package.mjs",
    "test": "vitest run --maxWorkers=2 --testTimeout=30000",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "jsonc-parser": "3.3.1",
    "picocolors": "1.1.1",
    "playwright-core": "1.62.1",
    "tinyglobby": "0.2.17",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "26.3.0",
    "commander": "15.0.0",
    "execa": "10.0.1",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "ultracite": "7.10.6",
    "vitest": "4.1.11"
  }
}
