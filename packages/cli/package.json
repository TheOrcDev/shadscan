{
  "name": "shadscan",
  "version": "0.0.1",
  "description": "Audit React shadcn apps for missing UI fundamentals.",
  "license": "UNLICENSED",
  "type": "module",
  "homepage": "https://github.com/TheOrcDev/headless-shadcn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheOrcDev/headless-shadcn.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/TheOrcDev/headless-shadcn/issues"
  },
  "keywords": [
    "shadcn",
    "accessibility",
    "audit",
    "cli",
    "react",
    "ui"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "shadscan": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "tsup",
    "docs:rules": "node --import tsx scripts/generate-rule-catalog.ts",
    "docs:rules:check": "node --import tsx scripts/generate-rule-catalog.ts --check",
    "prepack": "pnpm build",
    "smoke": "node scripts/smoke-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "commander": "13.1.0",
    "jsonc-parser": "3.3.1",
    "picocolors": "1.1.1",
    "tinyglobby": "0.2.15",
    "typescript": "5.9.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "20.19.25",
    "execa": "9.6.1",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "ultracite": "7.8.3",
    "vitest": "3.2.4"
  }
}
