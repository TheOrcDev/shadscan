    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tar-stream": "^3.2.1",
    "tw-animate-css": "^1.4.0",
    "web-haptics": "^0.0.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.10",
    "@next/env": "16.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-shape": "^3.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/tar-stream": "^3.1.4",
    "drizzle-kit": "^0.31.10",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "ultracite": "7.10.6",
    "vitest": "4.1.11"
  },
  "name": "shadscan-site",
  "engines": {
    "node": "24.x",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "api:keygen": "node scripts/generate-api-key.mjs",
    "audit:dependencies": "pnpm audit --prod --audit-level moderate",
    "audit:self": "pnpm cli:build && pnpm ci:audit-self",
    "brand:assets": "node --import tsx scripts/generate-brand-assets.mjs",
    "brand:assets:check": "node --import tsx scripts/generate-brand-assets.mjs --check",
    "build": "next build",
    "check": "ultracite check",
    "ci:audit-self": "node packages/cli/dist/cli.js --fail-under 92",
    "ci:build-site": "next build",
    "ci:test-api": "vitest run test/shadscan-api",
    "ci:test-e2e": "playwright test",
    "ci:test-web": "vitest run test/shadscan-web",
    "ci:typecheck": "next typegen && tsc --noEmit",
    "cli:build": "pnpm --filter ./packages/cli build",
    "cli:dev": "pnpm --filter ./packages/cli dev",
    "cli:pack:dry-run": "npm pack ./packages/cli --dry-run",
    "cli:release:check": "pnpm --filter ./packages/cli release:check",
    "cli:smoke": "pnpm --filter ./packages/cli smoke",
    "cli:smoke:built": "pnpm --filter ./packages/cli smoke:built",
    "cli:test": "pnpm --filter ./packages/cli test",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:provision-runtime": "node scripts/provision-database-runtime.mjs",
    "db:verify": "node scripts/verify-rate-limit-database.mjs",
    "dev": "next dev",
    "docs:check": "pnpm --filter ./packages/cli docs:rules:check && pnpm docs:pins:check && pnpm brand:assets:check",
    "docs:pins:check": "node scripts/verify-version-pins.mjs",
    "docs:rules": "pnpm --filter ./packages/cli docs:rules",
    "fix": "ultracite fix",
    "postbuild": "pnpm verify:trace",
    "prebuild": "pnpm cli:build && pnpm docs:check",
    "predev": "pnpm cli:build",
    "pretest:api": "pnpm cli:build",
    "pretest:e2e": "pnpm cli:build",
    "pretest:web": "pnpm cli:build",
    "pretypecheck": "pnpm cli:build",
    "start": "next start",
    "test:api": "pnpm ci:test-api",
    "test:e2e": "pnpm ci:test-e2e",
    "test:web": "pnpm ci:test-web",
    "typecheck": "pnpm ci:typecheck",
    "verify:trace": "node scripts/verify-production-trace.mjs"
  },
  "type": "module",
  "version": "0.0.1",
  "private": true
}
