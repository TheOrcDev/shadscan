    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-array": "^3.2.4",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "jotai": "^2.20.3",
