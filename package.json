{
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "shadscan": "workspace:*",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tar-stream": "^3.2.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tar-stream": "^3.1.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ultracite": "7.8.3",
    "vitest": "3.2.4"
  },
  "name": "shadscan-site",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "predev": "pnpm cli:build",
    "dev": "next dev",
    "prebuild": "pnpm cli:build",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "pnpm cli:build",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "cli:dev": "pnpm --filter shadscan dev",
    "cli:build": "pnpm --filter shadscan build",
    "cli:test": "pnpm --filter shadscan test",
    "cli:pack:dry-run": "npm pack ./packages/cli --dry-run",
    "cli:smoke": "pnpm --filter shadscan smoke",
    "pretest:api": "pnpm cli:build",
    "test:api": "vitest run test/shadscan-api",
    "api:keygen": "node scripts/generate-api-key.mjs",
    "audit:self": "pnpm cli:build && node packages/cli/dist/cli.js --fail-under 100"
  },
  "type": "module",
  "version": "0.0.1",
  "private": true
}
