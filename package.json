{
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@rexa-developer/tiks": "^0.3.0",
    "@shadscan/cli": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "jotai": "^2.20.2",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tar-stream": "^3.2.0",
    "tw-animate-css": "^1.4.0",
    "web-haptics": "^0.0.6",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.4.16",
    "@next/env": "16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tar-stream": "^3.1.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ultracite": "7.8.3",
    "vitest": "3.2.4"
  },
  "name": "shadscan-site",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.16.0",
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.7",
      "js-yaml": "4.3.0",
      "next>postcss": "8.5.15"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "predev": "pnpm cli:build",
    "dev": "next dev",
    "prebuild": "pnpm cli:build",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "pnpm cli:build",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "cli:dev": "pnpm --filter ./packages/cli dev",
    "cli:build": "pnpm --filter ./packages/cli build",
    "cli:test": "pnpm --filter ./packages/cli test",
    "cli:pack:dry-run": "npm pack ./packages/cli --dry-run",
    "cli:smoke": "pnpm --filter ./packages/cli smoke",
    "cli:release:check": "pnpm --filter ./packages/cli release:check",
    "docs:rules": "pnpm --filter ./packages/cli docs:rules",
    "docs:check": "pnpm --filter ./packages/cli docs:rules:check",
    "pretest:api": "pnpm cli:build",
    "test:api": "vitest run test/shadscan-api",
    "pretest:web": "pnpm cli:build",
    "test:web": "vitest run test/shadscan-web",
    "pretest:e2e": "pnpm cli:build",
    "test:e2e": "playwright test",
    "api:keygen": "node scripts/generate-api-key.mjs",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:provision-runtime": "node scripts/provision-database-runtime.mjs",
    "db:verify": "node scripts/verify-rate-limit-database.mjs",
    "audit:self": "pnpm cli:build && node packages/cli/dist/cli.js --fail-under 100",
    "audit:dependencies": "pnpm audit --prod --audit-level moderate",
    "verify:trace": "node scripts/verify-production-trace.mjs",
    "postbuild": "pnpm verify:trace"
  },
  "type": "module",
  "version": "0.0.1",
  "private": true
}
